# ============================================================
# AULOAVA · Variables de entorno (EJEMPLO)
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: NUNCA se sube al repositorio.
# En producción (Netlify) define estas mismas variables en
# Site settings -> Environment variables.
# ============================================================

# --- Agente de AliExpress (backend / Netlify Function) ---
# La automatización usa la API OFICIAL de AliExpress Affiliate (sin navegador).
# Consíguelas en la consola de afiliados de AliExpress (Portals / Open Platform).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Tu Tracking ID de AliExpress (el que marcaste como default): auloava
ALIEXPRESS_TRACKING_ID=auloava

# --- Amazon Associates (PA-API 5.0) ---
# Partner Tag = tu Store ID: auloava-20
AMAZON_PARTNER_TAG=auloava-20
# Access Key y Secret Key de Product Advertising API (desde tu cuenta Associates).
# Nota: PA-API requiere que la cuenta esté aprobada (3 ventas en 180 días).
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1

# Búsqueda usada para traer productos (puedes cambiarla)
AGENT_SEARCH=gadgets
# Cantidad de productos a importar
AGENT_COUNT=12

# Clave compartida que protege la Netlify Function del agente.
# Debe ser igual en AGENT_API_KEY (servidor) y VITE_AGENT_KEY (cliente).
AGENT_API_KEY=
VITE_AGENT_KEY=

# --- Persistencia en Firebase (para reemplazar los productos demo) ---
# Cuenta de servicio de Firebase (JSON completo, una línea)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://auloava-default-rtdb.europe-west1.firebasedatabase.app

# --- Capa de IA (redactor de borradores sociales 80% IA) ---
# Proveedor: openai | claude
AI_PROVIDER=openai
AI_API_KEY=
# Modelo opcional (si lo dejas vacío se usa uno por defecto del proveedor)
AI_MODEL=
