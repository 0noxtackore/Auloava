# ============================================================
# AULOAVA · Variables de entorno (EJEMPLO)
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: NUNCA se sube al repositorio.
# En producción (Netlify) define estas mismas variables en
# Site settings -> Environment variables.
# ============================================================

# --- Agente de AliExpress (solo en el backend / Netlify Function) ---
# El correo y la contraseña NO se exponen nunca al navegador.
ALIEXPRESS_EMAIL=tutequeman@gmail.com
ALIEXPRESS_PASSWORD=

# Búsqueda usada para traer productos aleatorios (puedes cambiarla)
AGENT_SEARCH=gadgets
# Cantidad de productos a importar
AGENT_COUNT=12

# Clave compartida que protege la Netlify Function del agente.
# Debe ser igual en AGENT_API_KEY (servidor) y VITE_AGENT_KEY (cliente).
AGENT_API_KEY=
VITE_AGENT_KEY=

# --- Enlaces de afiliado (opcional pero recomendado) ---
# Opción A (recomendada): API oficial de AliExpress Affiliate
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Opción B (fallback simple): solo añade ?aff_id=... a la URL
ALIEXPRESS_AFF_ID=

# --- Persistencia en Firebase (para reemplazar los productos demo) ---
# Cuenta de servicio de Firebase (JSON completo, una línea)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://auloava-default-rtdb.europe-west1.firebasedatabase.app
