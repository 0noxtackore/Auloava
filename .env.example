# Backend de productos
# Pon VITE_USE_FIREBASE=true para usar Firestore como backend real.
# Requiere haber creado la base de datos (Firestore) en la consola de Firebase
# y aplicado unas reglas de seguridad (ver reglas sugeridas abajo).
VITE_USE_FIREBASE=true

# Pon VITE_MOCK_API=false si quieres desactivar el mock aunque uses Firebase.
VITE_MOCK_API=false

# ------------------------------------------------------------
# Reglas de seguridad sugeridas para Realtime Database
# (Firebase console > Realtime Database > Reglas > Publicar)
# ------------------------------------------------------------
# {
#   "rules": {
#     "products": {
#       ".read": true,
#       ".write": "auth != null"
#     }
#   }
# }
